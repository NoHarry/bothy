# Agent relay settings. Copy to relay.env next to relay.cjs (chmod 600); relay.env is git-ignored.
# Never put real values in this example or any tracked file.

# Listen address: keep it on loopback (or a private address) behind your HTTPS reverse proxy.
RELAY_HOST=127.0.0.1
RELAY_PORT=18790
# Public HTTPS base the car and Grok use; the agent card, /connect page and callback URLs are built from it.
RELAY_PUBLIC_URL=https://relay.example.com

# Optional: the server owner's own Grok. Cars and users that pair on /connect need none of this; when any of the
# three below is set, all of them are required.
# Comma-separated bearer tokens, one per car or tester, at least 24 characters each.
RELAY_CLIENT_TOKENS=REPLACE_WITH_RANDOM_TOKEN
# Bearer token(s) for the bot's custom MCP connector (POST /mcp); different from the car tokens. Leave unset to
# have the bot call back with curl instead.
RELAY_MCP_TOKENS=REPLACE_WITH_ANOTHER_RANDOM_TOKEN
# The Grok Bot routine's webhook URL and key, from the routine details.
GROK_WEBHOOK_URL=https://REPLACE_WITH_WEBHOOK_URL
GROK_WEBHOOK_KEY=REPLACE_WITH_WEBHOOK_KEY

# Optional.
RELAY_AGENT_NAME=Grok Bot
# RELAY_AGENT_SKILLS=发邮件、查资料、设提醒、网购等需要个人账号的事务
# RELAY_TASK_TIMEOUT_MINUTES=15
# RELAY_MAX_TASKS_PER_HOUR=30
# RELAY_DATA_FILE=/path/to/tasks.json
# RELAY_ACCOUNTS_FILE=/path/to/accounts.json
# Hosts a paired user's routine webhook may live on (and their subdomains).
# RELAY_WEBHOOK_HOSTS=cursor.sh
# Registrations and claims per source address per hour.
# RELAY_CONNECT_PER_HOUR=20
