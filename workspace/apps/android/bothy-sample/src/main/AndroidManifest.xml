<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice session (Settings → 语音): the mic opens only after the user taps 语音唤醒; audio is never stored. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The overlay's background-start fallback runs it in the foreground; Android 14 requires a declared type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 悬浮窗语音唤醒 (off by default): while on, DebugVoiceForegroundService holds the microphone as a foreground
         service so the on-device wake word 你好，小博 still hears behind other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 计划: reminders at their minute. Android 12-13 ask for SCHEDULE_EXACT_ALARM, 13+ grant USE_EXACT_ALARM; without
         either the alarm is inexact (DebugPlanRunner). Android 11 and older need neither. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android Use, granted only to a build signed with the device's platform key: the 小博 cursor uses a TYPE_DRAG
         window above the dock, and the 操作屏幕 switch enables the accessibility service itself. Other builds ask the
         user to enable the accessibility service in the system settings. -->
    <uses-permission
        android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- An app signed like this one (Bothy Playground) may show the assistant in its own screen: DebugAssistantSurface. -->
    <permission
        android:name="cc.noharry.bothy.permission.ASSISTANT_SURFACE"
        android:protectionLevel="signature" />
    <uses-permission android:name="cc.noharry.bothy.permission.ASSISTANT_SURFACE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bothy Sample"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:name=".DebugSampleApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <activity
            android:name=".DebugConsoleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AgentRuntimeSmokeActivity"
            android:exported="true" />
        <receiver
            android:name=".DebugAssistantSurfaceReceiver"
            android:exported="true"
            android:permission="cc.noharry.bothy.permission.ASSISTANT_SURFACE">
            <intent-filter>
                <action android:name="cc.noharry.bothy.sample.ASSISTANT_SURFACE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugTextBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.sample.DEBUG_SEND_TEXT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugPlanNoticeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.sample.DEBUG_PLAN_NOTICE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugA2aProfileBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.sample.DEBUG_A2A_PROFILE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugImageModelBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.sample.DEBUG_IMAGE_MODEL" />
            </intent-filter>
        </receiver>
        <service
            android:name=".DebugOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant card that answers A2A and voice requests over other apps" />
        </service>
        <service
            android:name=".DebugVoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Notification access for it lets 小博 see and control what other apps play (Device Media); it reads no notification. -->
        <service
            android:name="cc.noharry.agent.device.DeviceMediaListenerService"
            android:exported="true"
            android:label="Bothy 媒体控制"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".DebugBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DebugPlanAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
