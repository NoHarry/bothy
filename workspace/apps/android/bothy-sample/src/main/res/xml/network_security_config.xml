<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Bench-only trust extension. Some bench devices ship a trimmed CA store that omits
      the DigiCert Global Root G2 / TrustAsia roots backing api.deepseek.com. To keep the debug
      console able to reach the live provider on those benches without modifying the runtime
      library transport, bundle the provider's root and intermediate CA here as a trust anchor.
      This is a bothy-sample concern only; it does not change bothy-runtime.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/deepseek_cas" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
