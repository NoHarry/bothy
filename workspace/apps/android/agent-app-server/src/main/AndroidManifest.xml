<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app server's own components; permissions and the application stay with the app. -->
    <application>
        <!-- Android Use's accessibility service, which the runtime's library declares: off, so it is not even listed in
             the system's settings, until a host that operates the screen turns it on in its own manifest. -->
        <service
            android:name="cc.noharry.agent.androiduse.AndroidUseAccessibilityService"
            android:enabled="false" />
        <!-- Off until the server turns it on for a host that wants it (plans, starting after boot). -->
        <receiver
            android:name="cc.noharry.agent.appserver.BootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="cc.noharry.agent.appserver.plans.PlanAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
