    <string name="skills_check_indent">第 %1$d 行：缩进的内容只能写在 metadata 这样空着值的字段下面。</string>
    <string name="skills_check_not_field">第 %1$d 行不是「字段: 值」的格式。</string>
    <string name="skills_check_duplicate">字段 %1$s 写了两遍。</string>
    <string name="skills_check_unknown_field">第 %1$d 行：不认识的字段「%2$s」，只能用 %3$s。</string>
    <string name="skills_check_single_quotes">%1$s 用双引号或不加引号：运行时不认单引号。</string>
    <string name="skills_check_name_empty">name 是空的。</string>
    <string name="skills_check_name_format">name「%1$s」只能用小写英文字母、数字和 -，不能以 - 开头或结尾，不能连着写 --，最长 %2$d 个字符。</string>
    <string name="skills_check_name_taken">已经有叫「%1$s」的技能，换个名字（改自己加的技能请在列表里点编辑）。</string>
    <string name="skills_check_no_description">缺少 description：一句话写清做什么、什么时候用，模型靠它决定要不要读这个技能。</string>
    <string name="skills_check_description_line">description 要写在「description:」同一行：运行时按行读。</string>
    <string name="skills_check_description_long">description 超过 %1$d 个字符。</string>
    <string name="skills_check_description_brackets">description 里不能有尖括号 &lt; &gt;。</string>
    <string name="skills_check_description_short">description 太短：写清做什么、什么时候用，模型才知道什么时候读它。</string>
    <string name="skills_check_sections">「&lt;!-- %1$s --&gt;」和「&lt;!-- /%1$s --&gt;」没有成对出现。</string>

