<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bothy's own components; permissions and the application stay with the app. -->
    <application>
        <activity
            android:name="cc.noharry.bothy.server.AgentRuntimeSmokeActivity"
            android:exported="true" />
        <receiver
            android:name="cc.noharry.bothy.server.TextBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.DEBUG_SEND_TEXT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="cc.noharry.bothy.server.plans.PlanNoticeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cc.noharry.bothy.DEBUG_PLAN_NOTICE" />
            </intent-filter>
        </receiver>
        <service
            android:name="cc.noharry.bothy.server.voice.VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="cc.noharry.agent.device.DeviceMediaListenerService"
            android:exported="true"
            android:label="Bothy 媒体控制"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
